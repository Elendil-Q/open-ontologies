# A malformed rule: the body's atom list has a cell with no rdf:rest, so it
# never reaches rdf:nil. Read short it would be a rule with FEWER conditions,
# which fires MORE often than the one written. Refused rather than truncated.
@prefix :     <http://example.org/family#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix var:  <urn:swrl#> .

var:x a swrl:Variable .
var:y a swrl:Variable .

:truncated a swrl:Imp ;
    swrl:body _:cell1 ;
    swrl:head ( [ a swrl:IndividualPropertyAtom ;
                  swrl:propertyPredicate :hasUncle ;
                  swrl:argument1 var:x ; swrl:argument2 var:y ] ) .

_:cell1 rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:propertyPredicate :hasParent ;
                    swrl:argument1 var:x ; swrl:argument2 var:y ] .
