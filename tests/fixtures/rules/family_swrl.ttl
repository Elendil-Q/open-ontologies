# Two SWRL rules in the RDF encoding, the form a SWRL rule takes inside an OWL
# ontology: swrl:Imp with swrl:body and swrl:head as rdf:List atom lists.
#
# The second rule is the one decision 0003 warns about. It is a perfectly valid
# SWRL rule, it is assumed and never checked, and a certificate over a table
# containing it checks green for ever. That is why a table out of this importer
# can only earn `entailed_under_supplied_rules`.
@prefix :     <http://example.org/family#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix var:  <urn:swrl#> .

var:x a swrl:Variable .
var:y a swrl:Variable .
var:z a swrl:Variable .

:uncle a swrl:Imp ;
    swrl:body (
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate :hasParent ;
          swrl:argument1 var:x ; swrl:argument2 var:y ]
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate :hasBrother ;
          swrl:argument1 var:y ; swrl:argument2 var:z ]
    ) ;
    swrl:head (
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate :hasUncle ;
          swrl:argument1 var:x ; swrl:argument2 var:z ]
    ) .

:every-supplier-is-compliant a swrl:Imp ;
    swrl:body ( [ a swrl:ClassAtom ; swrl:classPredicate :Supplier  ; swrl:argument1 var:x ] ) ;
    swrl:head ( [ a swrl:ClassAtom ; swrl:classPredicate :Compliant ; swrl:argument1 var:x ] ) .
