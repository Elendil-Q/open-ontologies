# A rule whose head is not a permitted form: an empty consequent. In SWRL that
# is an integrity constraint (the body must never hold); a Horn rule has exactly
# one head atom and there is nothing here to derive.
@prefix :     <http://example.org/family#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix var:  <urn:swrl#> .

var:x a swrl:Variable .

:no-supplier-is-banned a swrl:Imp ;
    swrl:body ( [ a swrl:ClassAtom ; swrl:classPredicate :Supplier ; swrl:argument1 var:x ]
                [ a swrl:ClassAtom ; swrl:classPredicate :Banned   ; swrl:argument1 var:x ] ) ;
    swrl:head () .
